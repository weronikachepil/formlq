rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuth() {
      return request.auth != null;
    }

    function role() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isEditor() {
      return isAuth() && role() == "editor";
    }

    function isTutor() {
      return isAuth() && (role() == "tutor" || role() == "editor");
    }

    function isOwner(uid) {
      return isAuth() && request.auth.uid == uid;
    }

    // Accounts that must always stay editor (keep in sync with PROTECTED_EMAILS in src/lib/users.ts)
    function protectedEmails() {
      return ["nazariichepil@gmail.com"];
    }
    // Block any write to a protected user's doc that would change their role away from editor.
    function protectedRoleOk() {
      return !(
        resource != null
        && (resource.data.email in protectedEmails())
        && request.resource.data.role != "editor"
      );
    }

    // True when the given homework doc belongs to the current tutor.
    function ownsHomework(hwId) {
      return isAuth() &&
        get(/databases/$(database)/documents/homework/$(hwId)).data.tutorId == request.auth.uid;
    }

    // Users — any signed-in user may read profiles (needed to find students by email);
    // writes only by the owner or an editor.
    // At sign-up a user may only pick "student" or "tutor"; afterwards nobody but an
    // editor changes a role (so no one can make themselves an editor).
    match /users/{uid} {
      allow read: if isAuth();
      allow create: if (isEditor() || (isOwner(uid) && request.resource.data.role in ["student", "tutor"]))
        && protectedRoleOk();
      allow update: if (
          isEditor()
          || (isOwner(uid) && request.resource.data.get("role", "student") == resource.data.get("role", "student"))
        ) && protectedRoleOk();
      allow delete: if isEditor();

      // Boards this user opened (shown in their «Дошки»); private to them.
      match /boardVisits/{boardId} {
        allow read, write: if isOwner(uid);
      }
    }

    // A non-editor tutor: a teacher, who sees only their own tests.
    function isTeacher() {
      return isAuth() && role() == "tutor";
    }

    // A teacher's test: theirs and marked personal. Published to the catalog only
    // with a description (subtitle) and the author's name.
    function nonEmpty(field) {
      return request.resource.data.get(field, "") is string
        && request.resource.data.get(field, "").size() > 0;
    }
    function teacherTestOk() {
      return request.resource.data.createdBy == request.auth.uid
        && request.resource.data.get("personal", false) == true
        && (request.resource.data.get("published", false) == false
            || (nonEmpty("subtitle") && nonEmpty("authorName")));
    }

    // Tests. Editors: everything. Teachers: only their own (createdBy), plus a test
    // someone shared by link; they may publish theirs to the catalog (see teacherTestOk).
    // Students: any test by id (catalog, homework, links).
    // A test with link access "anyone" may be fetched without an account (QR / public link),
    // published or not; publicAccess is the legacy form of the same. Listing requires sign-in.
    match /tests/{testId} {
      allow get: if resource.data.get("linkAccess", "off") == "anyone"
        || resource.data.get("publicAccess", false) == true
        || (isAuth() && (
          isEditor()
          || resource.data.get("createdBy", "") == request.auth.uid
          || resource.data.get("linkAccess", "off") == "students"
          || !isTeacher()
        ));
      // Queries must be filtered to match: published == true (catalog) or createdBy == me.
      allow list: if isEditor()
        || (isAuth() && resource.data.createdBy == request.auth.uid)
        || (isAuth() && resource.data.published == true && !isTeacher());
      allow create: if isEditor() || (isTeacher() && teacherTestOk());
      allow update: if isEditor()
        || (isTeacher() && resource.data.get("createdBy", "") == request.auth.uid && teacherTestOk());
      allow delete: if isEditor() || (isTeacher() && resource.data.get("createdBy", "") == request.auth.uid);
    }

    // Test folders. Platform folders (no ownerId) — editors; a teacher's own folders carry ownerId.
    match /testFolders/{folderId} {
      allow get: if isEditor() || (isAuth() && resource.data.get("ownerId", "") == request.auth.uid);
      // Teachers' queries filter on ownerId == me.
      allow list: if isEditor() || (isAuth() && resource.data.ownerId == request.auth.uid);
      allow create: if isEditor()
        || (isTeacher() && request.resource.data.ownerId == request.auth.uid);
      allow update: if isEditor()
        || (isTeacher() && resource.data.get("ownerId", "") == request.auth.uid
            && request.resource.data.ownerId == request.auth.uid);
      allow delete: if isEditor()
        || (isTeacher() && resource.data.get("ownerId", "") == request.auth.uid);
    }
    
    // Test results
    match /testResults/{resultId} {
      allow read: if isAuth() && (
        resource.data.userId == request.auth.uid
        || isEditor()
        || (isTutor() && ("homeworkId" in resource.data) && ownsHomework(resource.data.homeworkId))
      );
      allow create: if isAuth() && request.resource.data.userId == request.auth.uid;
      // Owner may update their own result (e.g. duck flags); the owning tutor may add comments.
      allow update: if isAuth() && (
        resource.data.userId == request.auth.uid
        || isEditor()
        || (isTutor() && ("homeworkId" in resource.data) && ownsHomework(resource.data.homeworkId))
      );
      allow delete: if isEditor();
    }

    // Homework assignments
    match /homework/{hwId} {
      allow read: if isAuth() && (
        resource.data.tutorId == request.auth.uid
        || resource.data.studentId == request.auth.uid
        || isEditor()
      );
      allow create: if isTutor() && request.resource.data.tutorId == request.auth.uid;
      // Tutor owns it; student may update their own (status, resultId) on submit.
      allow update: if isAuth() && (
        resource.data.tutorId == request.auth.uid
        || resource.data.studentId == request.auth.uid
        || isEditor()
      );
      allow delete: if isAuth() && (resource.data.tutorId == request.auth.uid || isEditor());
    }

    // Tutor ↔ student links
    match /tutorStudents/{linkId} {
      // resource == null allows reading a not-yet-existing link (the dup-check before create)
      allow read: if isAuth() && (
        resource == null
        || resource.data.tutorId == request.auth.uid
        || resource.data.studentId == request.auth.uid
        || isEditor()
      );
      // Only students can be linked: tutors/editors never get a tutor of their own.
      allow create: if (isEditor() || (isTutor() && request.resource.data.tutorId == request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.resource.data.studentId)).data.role == "student";
      // A student joins a teacher by invite code/link: only themselves, only to a tutor/editor,
      // under the canonical `${tutorId}_${studentId}` id.
      allow create: if isAuth()
        && request.resource.data.studentId == request.auth.uid
        && role() == "student"
        && linkId == request.resource.data.tutorId + "_" + request.auth.uid
        && get(/databases/$(database)/documents/users/$(request.resource.data.tutorId)).data.role in ["tutor", "editor"];
      allow delete: if isAuth() && (resource.data.tutorId == request.auth.uid || isEditor());
      // A student who renamed themselves refreshes their name on the link.
      allow update: if isAuth() && resource.data.studentId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["studentName"]);
    }

    // Tutor's student groups. Homework and lessons for a group are copied to each member,
    // so students need no access here; a tutor sees and edits only their own groups.
    match /groups/{groupId} {
      allow read: if isAuth() && (resource.data.tutorId == request.auth.uid || isEditor());
      allow create: if isTutor() && request.resource.data.tutorId == request.auth.uid
        && request.resource.data.name is string && request.resource.data.name.size() > 0
        && request.resource.data.studentIds is list;
      allow update: if isAuth() && resource.data.tutorId == request.auth.uid
        && request.resource.data.tutorId == resource.data.tutorId
        && request.resource.data.studentIds is list;
      allow delete: if isAuth() && (resource.data.tutorId == request.auth.uid || isEditor());
    }

    // Lessons (calendar)
    match /lessons/{lessonId} {
      allow read: if isAuth() && (
        resource.data.tutorId == request.auth.uid
        || resource.data.studentId == request.auth.uid
        || isEditor()
      );
      allow create: if isEditor() || (isTutor() && request.resource.data.tutorId == request.auth.uid);
      allow update, delete: if isAuth() && (resource.data.tutorId == request.auth.uid || isEditor());
      // A student who renamed themselves refreshes their name on their lessons.
      allow update: if isAuth() && resource.data.studentId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["studentName"]);
    }

    // Whiteboards — listing metadata only; the live board is in the Realtime Database.
    // Any signed-in user with the link may open a board; anyone may create their own.
    match /boards/{boardId} {
      allow read: if isAuth();
      allow create: if isAuth() && request.resource.data.ownerId == request.auth.uid;
      allow update: if isAuth() && resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerId == resource.data.ownerId;
      allow delete: if isAuth() && (resource.data.ownerId == request.auth.uid || isEditor());
    }

    // Tips — read by any auth user, write by editors only
    match /tips/{tipId} {
      allow read: if isAuth();
      allow write: if isEditor();
    }

    // Questions bank — the platform's: read by students and editors (daily question,
    // test building), not by teachers; write by editors only
    match /questions/{questionId} {
      allow read: if isAuth() && !isTeacher();
      allow write: if isEditor();
    }

    // Daily answers — read/create by owner, read by editor
    match /dailyAnswers/{docId} {
      // resource == null allows checking a not-yet-answered day (getTodayDailyAnswer)
      allow read: if isAuth() && (
        resource == null
        || resource.data.userId == request.auth.uid
        || isEditor()
      );
      allow create: if isAuth() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isEditor();
    }
  }
}
